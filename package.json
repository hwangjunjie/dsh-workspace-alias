{
  "name": "dsh-workspace-alias",
  "version": "0.4.2",
  "description": "DeepSeek Harness plugin: cross-device workspace path aliasing — let sessions synced from another machine (e.g. macOS /Volumes/Data/notes vs Windows F:\\notes) group into the local workspace of the same project.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible",
        "0.1.2-rc.1": "compatible"
      }
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/sync-client.mjs",
    "deploy": "node scripts/deploy.mjs",
    "release": "npm run build && npm run deploy",
    "test": "vitest run"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "alias"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
    "@types/node": "^22.20.1",
    "tsdown": "^0.12.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
